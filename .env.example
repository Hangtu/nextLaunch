# ==============================================================================
# NextLaunch — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] can be left empty — the feature will be disabled.
# Variables with defaults will use the shown value if not overridden.
# ==============================================================================

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ APP                                                                         │
# └─────────────────────────────────────────────────────────────────────────────┘
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ DATABASE — NeonDB (Serverless Postgres)                                     │
# │ Get your connection string at: https://console.neon.tech                    │
# └─────────────────────────────────────────────────────────────────────────────┘
# [REQUIRED]
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ AUTH — Clerk                                                                │
# │ Get your keys at: https://dashboard.clerk.com → API Keys                   │
# └─────────────────────────────────────────────────────────────────────────────┘
# [REQUIRED]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=clerk_publishable_key_here
CLERK_SECRET_KEY=clerk_secret_key_here

# Auth routes (defaults — only change if you customize your auth pages)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ PAYMENTS — Stripe                                                           │
# │ Get your keys at: https://dashboard.stripe.com/apikeys                     │
# │ Webhook secret: https://dashboard.stripe.com/webhooks                      │
# └─────────────────────────────────────────────────────────────────────────────┘
# [OPTIONAL] — leave empty to disable Stripe. App runs fine without it.
# Don't need payments at all? Delete src/lib/stripe.ts, src/app/api/webhooks/stripe/,
# these vars, and the `stripe`/`@stripe/stripe-js` packages — see docs/integrations.md.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ EMAIL — Resend                                                              │
# │ Get your API key at: https://resend.com/api-keys                           │
# └─────────────────────────────────────────────────────────────────────────────┘
# [OPTIONAL] — leave empty to disable transactional email. App runs fine without it.
# Don't need email at all? Delete src/lib/resend.ts, src/lib/email/, these vars,
# and the `resend` package — see docs/integrations.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ STORAGE — Cloudflare R2 (S3-compatible)                                     │
# │ Get your credentials at: https://dash.cloudflare.com → R2 → Manage API    │
# └─────────────────────────────────────────────────────────────────────────────┘
# [OPTIONAL] — leave empty to disable file storage. App runs fine without it.
# Don't need uploads at all? Delete src/lib/r2.ts, these vars, and the
# `@aws-sdk/client-s3` package — see docs/integrations.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ RATE LIMITING — Upstash Redis                                               │
# │ Get your REST URL/token at: https://console.upstash.com                    │
# └─────────────────────────────────────────────────────────────────────────────┘
# [OPTIONAL] — leave empty to use the in-memory rate limiter (fine for local
# dev; doesn't survive serverless — see docs/patterns-and-gotchas.md). Set
# these to upgrade to a real distributed limiter with no code change.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ ERROR MONITORING — Sentry                                                   │
# │ Get your DSN at: https://sentry.io → Project Settings → Client Keys        │
# │ Auth token: https://sentry.io → Settings → Auth Tokens                     │
# └─────────────────────────────────────────────────────────────────────────────┘
# [OPTIONAL] — leave empty to disable Sentry. App runs fine without it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ BUILD                                                                       │
# └─────────────────────────────────────────────────────────────────────────────┘
# Set to "true" in CI/CD or Vercel if env vars are not available during build.
# This skips Zod validation so the build doesn't fail on missing keys.
SKIP_ENV_VALIDATION=